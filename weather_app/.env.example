# OpenWeatherMap API Key
# Get a free API key at https://openweathermap.org/api
# Used for temperature, clouds, wind, and precipitation map layers
OPENWEATHERMAP_API_KEY=your_api_key_here

# Django settings
DJANGO_SECRET_KEY=your-secret-key
# Use True for local dev; set False in production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
RENDER_EXTERNAL_HOSTNAME=
# Comma-separated full origins, e.g. https://weather.example.com
DJANGO_CORS_ALLOWED_ORIGINS=
# Comma-separated full origins, e.g. https://weather.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database
# Example: postgresql://user@localhost:5432/weather
DATABASE_URL=

# Caching
# Example: redis://localhost:6379/0
REDIS_URL=
REDIS_DB=0

# Celery
# Example: redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# App-specific cache
CACHE_TIMEOUT=300
MODEL_DETAIL_CACHE_SECONDS=300
